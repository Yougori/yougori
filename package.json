{
  "name": "yougori",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "cli": "cargo run --quiet --manifest-path cli/Cargo.toml --",
    "cli:build": "cargo build --release --manifest-path cli/Cargo.toml",
    "cli:bundle": "node scripts/bundle-cli.mjs",
    "cli:test": "cargo test --manifest-path cli/Cargo.toml",
    "cli:test:runtime": "cargo test --manifest-path src-tauri/Cargo.toml --lib automation_real_cli_lifecycle_and_connections -- --ignored --nocapture --test-threads=1",
    "postinstall": "node scripts/patch-novnc.mjs",
    "predev": "node scripts/patch-novnc.mjs && node scripts/prepare-dev.mjs",
    "prebuild": "node scripts/patch-novnc.mjs",
    "pretest": "node scripts/patch-novnc.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test scripts/*.test.mjs && vitest run src",
    "test:watch": "vitest src",
    "test:e2e": "playwright test",
    "test:graph": "playwright test --config playwright.graph.config.ts",
    "test:terminal": "playwright test --config playwright.graph.config.ts host-terminal.spec.ts",
    "test:terminal:native": "cargo test --manifest-path src-tauri/Cargo.toml --lib host_terminal_real_powershell_cli_input_resize_and_owned_cleanup -- --ignored --nocapture --test-threads=1",
    "test:workspace": "cargo test --manifest-path src-tauri/Cargo.toml workspace_ -- --ignored --nocapture --test-threads=1",
    "check:native": "cargo check --manifest-path src-tauri/Cargo.toml --all-targets",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:harness": "pwsh -NoProfile -File scripts/test-bounded-test-process.ps1",
    "test:runtime": "cargo test --manifest-path src-tauri/Cargo.toml bundled_appliance_runs_snapshots_and_enforces_connections -- --ignored --nocapture && cargo test --manifest-path src-tauri/Cargo.toml bundled_qemu_exposes_qmp_and_vnc_websocket -- --ignored --nocapture && cargo test --manifest-path src-tauri/Cargo.toml bundled_alpine_micro_vm_exposes_qmp_without_a_display -- --ignored --nocapture",
    "test:startup": "cargo test --manifest-path src-tauri/Cargo.toml bundled_runtime_warm_verification_uses_the_metadata_cache -- --ignored --nocapture",
    "benchmark": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/benchmark-runtime.ps1",
    "verify": "npm run lint && npm test && npm run build && npm run cli:test && npm run check:native && npm run test:native",
    "verify:windows": "pwsh -NoProfile -File scripts/check-windows-test-prerequisites.ps1 && npm ci && npx playwright install chromium --no-shell && npm audit --audit-level=moderate && npm run release:check && npm run lint && npm test && npm run build && cargo +stable test --locked --manifest-path cli/Cargo.toml && cargo +stable test --locked --manifest-path runtime/cuda/host/Cargo.toml && cargo +stable check --locked --manifest-path src-tauri/Cargo.toml --all-targets && cargo +stable test --locked --manifest-path src-tauri/Cargo.toml --lib && npm run cli:bundle && npm run test:e2e && npm run test:harness",
    "runtime:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-bundled-runtime.ps1",
    "desktop:dev": "tauri dev",
    "desktop:dev:admin": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-desktop-dev-admin.ps1",
    "desktop:build": "tauri build",
    "branding:generate": "node scripts/generate-installer-branding.mjs",
    "branding:check": "node --test scripts/installer-branding.test.mjs",
    "release:check": "npm run branding:check && node scripts/release-preflight.mjs",
    "macos:doctor": "node scripts/macos-setup.mjs",
    "macos:setup": "node scripts/macos-setup.mjs --install",
    "macos:build": "bash scripts/build-macos.sh",
    "macos:test:runtime": "bash scripts/test-macos-runtime.sh",
    "tauri": "tauri"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@novnc/novnc": "1.7.0",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.8.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.542.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.13",
    "@tauri-apps/cli": "^2.8.4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.1",
    "@types/novnc__novnc": "^1.6.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "jsqr": "^1.4.0",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4",
    "vitest": "^4.1.11"
  }
}
