{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["app", "dmg"],
    "resources": {
      "../LICENSE": "LICENSE",
      "../node_modules/@novnc/novnc/": "third-party-sources/novnc/",
      "resources/runtime/appliance/": "runtime/appliance/",
      "resources/cli/yougori-cli": "cli/yougori-cli",
      "resources/cli/opendock-cli": "cli/opendock-cli",
      "resources/THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
